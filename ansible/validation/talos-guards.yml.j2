---
- name: Evaluate Talos mutation guards
  hosts: localhost
  gather_facts: false
  vars:
    talos_upgrade_test_mode: false
    talos_upgrade_kubernetes_node: fixture-node
    talos_generate_secrets_temp: {path: /tmp/fixture-secrets}
    talos_generate_output: {path: /tmp/fixture-output}
  tasks:
{% for entry in role_contract_flat %}
{% if entry.source.startswith('talos/tasks/') and (entry.task.keys() | intersect(['ansible.builtin.command', 'ansible.builtin.shell', 'ansible.builtin.copy', 'ansible.builtin.file', 'ansible.builtin.tempfile', 'kubernetes.core.k8s']) | length > 0) %}
{% set conditions = entry.guards | flatten %}
{% set guard = '((' ~ (conditions | join(') and (')) ~ '))' if conditions else 'true' %}
    - name: {{ (entry.source ~ ' ' ~ (entry.task.name | default('unnamed'))) | to_json }}
      ansible.builtin.assert:
        that:
          - {{ (guard ~ ' == (not ansible_check_mode)') | to_json }}
{% endif %}
{% endfor %}
