---
- name: Exercise Bitwarden bootstrap secret wiring
  hosts: localhost
  gather_facts: false
  vars:
    platform_bitwarden_access_token: fixture-token
    role_contract_secret: {{ role_contract_external_secret['kubernetes.core.k8s'].definition | to_json }}
  tasks:
    - name: Validate rendered bootstrap credential
      ansible.builtin.assert:
        that:
          - role_contract_secret.kind == 'Secret'
          - role_contract_secret.metadata.name == 'bitwarden-credentials'
          - role_contract_secret.metadata.namespace == 'platform-system'
          - "role_contract_secret.stringData == {'token': platform_bitwarden_access_token}"
