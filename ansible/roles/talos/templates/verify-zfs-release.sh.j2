set -eu
host() { nsenter --mount=/proc/1/ns/mnt --root=/proc/1/root -- "$@"; }
zp() { host /usr/local/sbin/zpool "$@"; }
zf() { host /usr/local/sbin/zfs "$@"; }
devnum() { stat -Lc '%t:%T' "/proc/1/root$1"; }

# Verify four partitions on four different whole disks, all distinct from the system SSD.
system=$(devnum '{{ talos_install_disk }}')
parents=' '
set --
for uuid in {{ talos_zfs_member_uuids | join(' ') }}; do
  path="/dev/disk/by-partuuid/$uuid"
  test -b "/proc/1/root$path"
  part=$(basename "$(readlink "/proc/1/root$path")")
  test -f "/sys/class/block/$part/partition"
  test "$(devnum "$path")" = "$(devnum "/dev/$part")"
  parent=$(basename "$(dirname "$(readlink "/sys/class/block/$part")")")
  test -b "/proc/1/root/dev/$parent"
  test ! -f "/sys/class/block/$parent/partition"
  num=$(devnum "/dev/$parent")
  test "$num" != "$system"
  case "$parents" in *" $num "*) exit 1 ;; esac
  parents="$parents$num "
  set -- "$@" -d "$path"
done

{% if not talos_live_zfs.released %}
pools=$(zp list -H -o name)
test -z "$pools"
zp import -N -o readonly=on -o cachefile=none "$@" '{{ talos_zfs_release_guid }}'
pool=$(zp list -H -o name)
trap 'zp export "$pool"' EXIT
test "$pool" = dpool
test "$(zp get -H -o value readonly dpool)" = on
test "$(zp get -H -o value cachefile dpool)" = none
{% else %}
test "$(zp list -H -o name)" = dpool
test "$(zp get -H -o value readonly dpool)" = off
{% endif %}
test "$(zp get -Hp -o value guid dpool)" = '{{ talos_zfs_release_guid }}'
test "$(zp get -H -o value health dpool)" = ONLINE
test "$(zp get -H -o value altroot dpool)" = '-'
test "$(zf list -H -o type dpool/k8s)" = filesystem
test "$(zf get -H -o value mountpoint dpool/k8s)" = none

properties=$(zf list -Hr -t filesystem -o name,canmount,mountpoint,sharenfs,sharesmb dpool)
printf '%s\n' "$properties" | awk -F '\t' '
  $4 != "off" || $5 != "off" {exit 1}
  $2 == "on" && $3 != "none" && $3 != "legacy" && $3 !~ "^/var/mnt(/|$)" {exit 1}
'
for dataset in dpool dpool/media dpool/restic; do
  test "$(zf get -H -o value canmount "$dataset")" = on
  test "$(zf get -H -o value mountpoint "$dataset")" = "/var/mnt/$dataset"
{% if not talos_live_zfs.released %}
  test "$(zf get -H -o value mounted "$dataset")" = no
{% else %}
  awk -v path="/var/mnt/$dataset" -v dataset="$dataset" '
    $4 == "/" && $5 == path && $6 ~ /(^|,)rw(,|$)/ { for (i=7; i<=NF; i++) if ($i=="-" && $(i+1)=="zfs" && $(i+2)==dataset) found=1 }
    END { exit !found }
  ' /proc/1/mountinfo
{% endif %}
done

status=$(zp status -LP dpool)
members=$(printf '%s\n' "$status" | awk '$1 ~ "^/dev/" {if ($2 != "ONLINE") exit 1; print $1}')
set -- $members
test "$#" -eq 4
for member in $members; do
  num=$(devnum "$member")
  match=''
  for uuid in {{ talos_zfs_member_uuids | join(' ') }}; do
    path="/dev/disk/by-partuuid/$uuid"
    if test "$(devnum "$path")" = "$num"; then
      match="$path"
      break
    fi
  done
  test -n "$match"
  echo "ZFS_MEMBER=$match"
done

{% if not talos_live_zfs.released %}
zp export "$pool"
trap - EXIT
pools=$(zp list -H -o name)
test -z "$pools"
{% endif %}
echo 'ZFS release checks passed'
