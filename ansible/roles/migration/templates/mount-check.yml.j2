apiVersion: v1
kind: Pod
metadata:
  generateName: migration-mounts-
  namespace: kube-system
spec:
  restartPolicy: Never
  automountServiceAccountToken: false
  nodeSelector:
    kubernetes.io/hostname: homelab
  tolerations:
    - operator: Exists
  containers:
    - name: verify
      image: "{{ migration_check_image }}"
      securityContext:
        privileged: true
      command:
        - sh
        - -ec
        - |
          zpool() { chroot /host /usr/local/sbin/zpool "$@"; }
          zfs() { chroot /host /usr/local/sbin/zfs "$@"; }
          test "$(zpool get -Hp -o value guid dpool)" = "$POOL_GUID"
          test "$(zpool list -H -o health dpool)" = ONLINE
          test "$(zfs list -H -o name dpool/k8s)" = dpool/k8s
          mountcheck() {
            awk -v path="/host/var/mnt/$1" -v source="$1" '$4 == "/" && $5 == path {for (i=7;i<=NF;i++) if ($i=="-" && $(i+1)=="zfs" && $(i+2)==source) found=1} END {exit !found}' /proc/self/mountinfo
          }
          mountcheck dpool/media
          # Match kubelet's OnRootMismatch ownership test before any media writer starts.
          test "$(stat -c %g /host/var/mnt/dpool/media)" = 0
          mode=$(stat -c %a /host/var/mnt/dpool/media)
          test "$((0$mode & 02770))" -eq "$((02770))"
          mountcheck dpool/restic
{% if migration_check_stage | default(false) | bool %}
          mountcheck {{ migration_dataset }}
          test "$(zfs get -H -o value readonly {{ migration_dataset }})" = on
          source="{{ migration_dataset }}@$SNAPSHOT"
          test "$(zfs get -Hp -o value guid "$source")" = "$SNAPSHOT_GUID"
          zfs holds -H "$source" | awk -F '\t' -v src="$source" '$1 == src && length($2) {ok=1} END {exit !ok}'
          awk -v src='{{ migration_dataset }}' '$5 == "/stage" {seen++
            if ($4=="/") for (i=7; i<NF; i++) {
              if ($i ~ /^shared:/) shared=1
              if ($i=="-" && $(i+1)=="zfs" && $(i+2)==src) ok=1
            }
          } END {exit !(seen==1 && shared && ok)}' /proc/self/mountinfo
          exec 9</stage
          flock -x 9
          path="/stage/.zfs/snapshot/$SNAPSHOT"
          hostpath="/host{{ migration_mount }}/.zfs/snapshot/$SNAPSHOT"
          mounted() { awk -v p="$1" '$5==p {ok=1} END {exit !ok}' /proc/self/mountinfo; }
          readonly_snapshot() {
            awk -v p="$1" -v src="$source" '$5==p {seen++
              if ($4=="/" && $6 ~ /(^|,)ro(,|$)/)
                for(i=7;i<NF;i++) if($i=="-" && $(i+1)=="zfs" && $(i+2)==src) ok=1
            } END {exit !(seen==1 && ok)}' /proc/self/mountinfo
          }
          if mounted "$path"; then
            readonly_snapshot "$path"
            readonly_snapshot "$hostpath"
{% if migration_detach_snapshot | default(false) | bool %}
            umount "$path"
{% endif %}
          else
            ! mounted "$hostpath" || exit 1
{% if not migration_detach_snapshot | default(false) | bool %}
            # OpenZFS's automatic lookup can leave an empty control-directory stub on Talos.
            mount -i -t zfs -o ro,nodev,nosuid "$source" "$path"
{% endif %}
          fi
{% if migration_detach_snapshot | default(false) | bool %}
          ! mounted "$path" || exit 1
          ! mounted "$hostpath" || exit 1
{% else %}
          readonly_snapshot "$path"
          readonly_snapshot "$hostpath"
{% endif %}
{% endif %}
      env:
        - name: POOL_GUID
          value: "{{ migration_identity.resources[0].data['pool-guid'] }}"
        - name: SNAPSHOT_GUID
          value: "{{ migration_snapshot_guid }}"
        - name: SNAPSHOT
          value: "{{ migration_snapshot }}"
      volumeMounts:
        - name: host
          mountPath: /host
          readOnly: true
          mountPropagation: HostToContainer
{% if migration_check_stage | default(false) | bool %}
        - name: stage
          mountPath: /stage
          mountPropagation: Bidirectional
{% endif %}
  volumes:
    - name: host
      hostPath:
        path: /
        type: Directory
{% if migration_check_stage | default(false) | bool %}
    - name: stage
      hostPath:
        path: "{{ migration_mount }}"
        type: Directory
{% endif %}
