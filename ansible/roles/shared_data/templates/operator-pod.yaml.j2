apiVersion: v1
kind: Pod
metadata:
  generateName: {{ shared_data_operation_id }}-
  namespace: {{ shared_data_namespace }}
  labels:
    app.kubernetes.io/name: shared-data
    home-ops/data-role: operator
    home-ops/data-operation: {{ shared_data_operation_id }}
spec:
  activeDeadlineSeconds: {{ shared_data_operator_lifetime | int }}
  serviceAccountName: {{ shared_data_serviceaccount }}
  restartPolicy: Never
  automountServiceAccountToken: true
  securityContext:
    runAsUser: 1000
    runAsGroup: 1000
    runAsNonRoot: true
    fsGroup: 1000
    fsGroupChangePolicy: OnRootMismatch
  containers:
    - name: operations
      image: {{ shared_data_image }}
      command: [python3, -c]
      args: ['import time; time.sleep({{ shared_data_operator_lifetime | int }})']
      env:
        - name: HOME
          value: /tmp
        - name: ANSIBLE_LOCAL_TEMP
          value: /tmp/ansible-local
        - name: ANSIBLE_REMOTE_TEMP
          value: /tmp/ansible-remote
        - name: XDG_CACHE_HOME
          value: /tmp/cache
        - name: POD_NAME
          valueFrom:
            fieldRef:
              fieldPath: metadata.name
        - name: POD_NAMESPACE
          valueFrom:
            fieldRef:
              fieldPath: metadata.namespace
        - name: POD_UID
          valueFrom:
            fieldRef:
              fieldPath: metadata.uid
      resources:
        requests:
          cpu: 100m
          memory: 256Mi
        limits:
          memory: 1Gi
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: true
        capabilities:
          drop: [ALL]
      volumeMounts:
        - name: tmp
          mountPath: /tmp
  volumes:
    - name: tmp
      emptyDir: {}
