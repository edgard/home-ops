---
- name: Exercise Terraform credential assertions
  hosts: localhost
  gather_facts: false
  vars:
    tofu_aws_access_key_id: fixture-key
    tofu_aws_secret_access_key: fixture-secret
    tofu_bws_access_token: fixture-token
    role_contract_environment: {{ role_contract_tofu_tasks[1].environment | to_json }}
  tasks:
{{ [role_contract_tofu_tasks[0]] | to_nice_yaml(indent=2) | indent(4, true) }}
    - name: Validate rendered Terraform environment
      ansible.builtin.assert:
        that:
          - role_contract_environment.AWS_ACCESS_KEY_ID == tofu_aws_access_key_id
          - role_contract_environment.AWS_SECRET_ACCESS_KEY == tofu_aws_secret_access_key
          - role_contract_environment.BWS_ACCESS_TOKEN == tofu_bws_access_token
          - role_contract_environment.BW_ACCESS_TOKEN == tofu_bws_access_token
