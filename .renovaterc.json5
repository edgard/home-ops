{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // === Presets ===
  extends: [
    "config:recommended",
    ":configMigration",
    ":semanticCommits",
    ":timezone(Europe/Warsaw)",
    ":prHourlyLimitNone",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
  ],

  // === Kubernetes Manager ===
  kubernetes: {
    managerFilePatterns: [
      "apps/*/**/manifests/**/*.yaml",
      "argocd/**/*.yaml",
    ],
  },

  // The Talos bootstrap patch contains a literal installer image reference.
  ansible: {
    managerFilePatterns: ["ansible/roles/talos/files/controlplane-patch.{yml,yaml}"],
  },

  // === Custom Managers ===
  customManagers: [
    // Helm charts in app metadata files (OCI and HTTP repositories)
    {
      customType: "regex",
      description: "Helm charts in app config files",
      managerFilePatterns: ["apps/*/*/app.{yml,yaml}"],
      matchStrings: [
        "repo:\\s*oci://(?<packageName>[^\\s]+)\\s+path:\\s*[\"']?\\.[\"']?\\s+version:\\s*(?<currentValue>\\S+)",
        "repo:\\s*(?<registryUrl>https://[^\\s]+)\\s+name:\\s*(?<depName>\\S+)\\s+version:\\s*(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "{{#if packageName}}docker{{else}}helm{{/if}}",
    },

    // Put the Renovate annotation immediately above the version or image.
    {
      customType: "regex",
      description: "Annotated versions and restore image tags",
      managerFilePatterns: [
        ".github/actions/setup-toolchain/action.yml",
        "apps/platform-system/tuppr/manifests/**/*.kubernetesupgrade.{yml,yaml}",
        "apps/platform-system/gateway-api/manifests/gateway-api-version.configmap.{yml,yaml}",
        "ansible/roles/{talos,cli_secrets,restic}/defaults/main.{yml,yaml}",
      ],
      matchStrings: [
        "(?:^|\\r?\\n)[ \\t]*# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[ \\t]*\\r?\\n[ \\t]*(?:version|IMAGE_TAG|kubeconform-version|YAMLFMT_VERSION|ACTIONLINT_VERSION|cli_secrets_secretspec_version):[ \\t]*[\"']?(?<currentValue>v?[0-9][^\\s\"']*)",
        "(?:^|\\r?\\n)[ \\t]*# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)[ \\t]*\\r?\\n[ \\t]*restic_restore_image:[ \\t]*[\"']?[^:\\s]+:(?<currentValue>[^\\s\"']+)",
      ],
    },
  ],

  // Maintain transitive Python dependencies and provider locks through PRs.
  lockFileMaintenance: {
    enabled: true,
    automerge: true,
  },

  // === Package Rules ===
  packageRules: [
    // Paperless's bundled client still sends the Gotenberg 8 pdfa form field.
    {
      description: "Keep Gotenberg compatible with the Paperless conversion client",
      matchDatasources: ["docker"],
      matchPackageNames: ["docker.io/gotenberg/gotenberg"],
      allowedVersions: "<9.0.0",
    },

    // The supported control-node Python range is reviewed with Ansible upgrades.
    {
      description: "Keep the supported Python range manually managed",
      matchManagers: ["pep621"],
      matchDepTypes: ["requires-python"],
      enabled: false,
    },

    {
      description: "Use the OpenTofu provider registry for dependency locks",
      matchDatasources: ["terraform-provider"],
      registryUrls: ["https://registry.opentofu.org"],
    },

    // Query-only include_shadow_metadata forces DNS PUTs; lift after a no-change plan proves the upstream fix.
    {
      description: "Keep Cloudflare below the DNS query-parameter regression",
      matchDatasources: ["terraform-provider"],
      matchPackageNames: ["cloudflare/cloudflare"],
      allowedVersions: "<5.26.0",
    },

    // Resolve Talos updates from upstream installer tags while keeping factory path in file
    {
      description: "Override Talos installer package name",
      matchDatasources: ["docker"],
      matchDepNames: ["/factory\\.talos\\.dev\\/metal-installer\\//"],
      matchPackageNames: ["/factory\\.talos\\.dev\\/metal-installer\\//"],
      overridePackageName: "ghcr.io/siderolabs/installer",
      allowedVersions: "/^v?1\\.13\\.[0-9]+$/",
    },

    // LinuxServer retains historic base-image tags such as 20.04.1 alongside qBittorrent releases.
    {
      description: "Ignore legacy LinuxServer qBittorrent base-image tags",
      matchDatasources: ["docker"],
      matchPackageNames: ["lscr.io/linuxserver/qbittorrent"],
      allowedVersions: "/^[1-9]\\.[0-9]+\\.[0-9]+$/",
    },

    // Manual review: Gateway API updates (CRD changes are risky)
    {
      description: "Require manual review for Gateway API updates",
      matchPackageNames: ["kubernetes-sigs/gateway-api"],
      automerge: false,
      groupName: "gateway-api",
      addLabels: ["renovate/manual-review"],
      postUpgradeTasks: {
        commands: [
          "curl -sL https://github.com/kubernetes-sigs/gateway-api/releases/download/{{{newVersion}}}/standard-install.yaml -o apps/platform-system/gateway-api/manifests/gateway-api-crds.yaml",
        ],
        fileFilters: ["apps/platform-system/gateway-api/manifests/**"],
        executionMode: "branch",
      },
    },

    // Deployment and operator-tool majors need review beyond static CI.
    {
      description: "Require manual review for majors outside the CI allowlist",
      matchUpdateTypes: ["major"],
      matchPackageNames: ["!kubernetes-sigs/gateway-api"],
      automerge: false,
      groupName: "dependencies (major)",
      labels: ["renovate/manual-review"],
    },

    {
      description: "Auto-merge majors of actions exercised by the PR gate",
      matchManagers: ["github-actions"],
      matchFileNames: [".github/workflows/ci.yml", ".github/actions/setup-toolchain/action.yml"],
      matchUpdateTypes: ["major"],
      groupName: "CI and validation tools (major)",
      automerge: true,
      labels: [],
    },

    {
      description: "Auto-merge majors of tools used only for CI and validation",
      matchFileNames: [".github/actions/setup-toolchain/action.yml", "pyproject.toml"],
      matchPackageNames: [
        "ansible-compat",
        "ansible-lint",
        "check-jsonschema",
        "google/yamlfmt",
        "json5",
        "jsonschema",
        "packaging",
        "pytest",
        "python-hcl2",
        "rhysd/actionlint",
        "ruff",
        "us-docker.pkg.dev/fairwinds-ops/oss/pluto",
        "yamllint",
        "yannh/kubeconform",
      ],
      matchUpdateTypes: ["major"],
      groupName: "CI and validation tools (major)",
      automerge: true,
      labels: [],
    },

    // Talos 1.14 retires this installer; migrate to Image Factory before lifting.
    {
      description: "Keep Talos on 1.13 until the installer migration is complete",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["siderolabs/talos"],
      allowedVersions: "<1.14.0",
    },

    // Talos 1.13 supports Kubernetes through 1.36. Upgrade the node before lifting.
    // https://docs.siderolabs.com/talos/v1.13/getting-started/support-matrix
    // Delay Kubernetes upgrades so validation schemas have time to publish
    {
      description: "Defer Kubernetes upgrades",
      matchDatasources: ["github-tags"],
      matchPackageNames: ["siderolabs/kubelet"],
      allowedVersions: "<1.37.0",
      minimumReleaseAge: "7 days",
      internalChecksFilter: "strict",
    },

    // Delay OpenTofu CLI updates so setup-opentofu installer metadata can publish
    {
      description: "Defer OpenTofu CLI updates",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["opentofu/opentofu"],
      minimumReleaseAge: "7 days",
      internalChecksFilter: "strict",
    },

    // Routine updates share one PR. Node release changes below override this rule.
    {
      description: "Auto-merge non-major updates",
      matchUpdateTypes: ["minor", "patch", "digest", "pin", "pinDigest", "rollback"],
      matchPackageNames: ["!kubernetes-sigs/gateway-api"],
      groupName: "dependencies (non-major)",
      automerge: true,
      automergeType: "pr",
    },

    {
      description: "Review Kubernetes release changes and downgrades before Tuppr applies them",
      matchPackageNames: ["siderolabs/kubelet"],
      matchUpdateTypes: ["major", "minor", "rollback"],
      groupName: "Kubernetes release",
      automerge: false,
      labels: ["renovate/manual-review"],
    },

    {
      description: "Review Talos release changes and downgrades together with the factory installer",
      matchFileNames: [
        "ansible/roles/talos/defaults/main.yml",
        "ansible/roles/talos/files/controlplane-patch.yaml",
      ],
      matchPackageNames: [
        "siderolabs/talos",
        "ghcr.io/siderolabs/installer",
        "/^factory\\.talos\\.dev\\/metal-installer\\//",
      ],
      matchUpdateTypes: ["major", "minor", "rollback"],
      groupName: "Talos release",
      automerge: false,
      labels: ["renovate/manual-review"],
    },

    // OpenTofu's required_version is manually managed; keep provider updates enabled.
    {
      description: "Disable Terraform CLI version updates (using OpenTofu)",
      matchManagers: ["terraform", "terraform-version"],
      matchPackageNames: ["hashicorp/terraform"],
      enabled: false,
    },
  ],
}
